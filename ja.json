{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "OpenOCD: build",
            "type": "shell",
            "command": "make -j\"$(nproc)\"",
            "options": {
                "cwd": "${workspaceFolder}/build",
                "env": {
                    "LC_ALL": "C"
                }
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}