{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenOCD: debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/openocd",
            "args": [
                "-s",
                "${workspaceFolder}/tcl",
                "-f",
                "${workspaceFolder}/scripts/cmsis-dap.cfg",
                "-f",
                "${workspaceFolder}/scripts/target_config.cfg"
            ],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LC_ALL",
                    "value": "C"
                }
            ],
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "OpenOCD: build"
        }
    ]
}